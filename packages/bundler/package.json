{
  "name": "@compatgate/bundler",
  "version": "0.0.0",
  "description": "A bundler plugin for webpack, rspack, Vite, Rollup, Rolldown and esbuild that finds JavaScript syntax and APIs that your browserslist targets do not support.",
  "keywords": [
    "browserslist",
    "compatibility",
    "esbuild",
    "rolldown",
    "rollup",
    "rspack",
    "unplugin",
    "vite",
    "webpack"
  ],
  "homepage": "https://github.com/compatgate/compatgate/tree/main/packages/bundler#readme",
  "bugs": {
    "url": "https://github.com/compatgate/compatgate/issues"
  },
  "license": "MIT OR Apache-2.0",
  "author": "Shamil Iakupov <me@shamil.tech>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/compatgate/compatgate.git",
    "directory": "packages/bundler"
  },
  "files": [
    "dist",
    "!dist/*.tsbuildinfo",
    "docs",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./webpack": {
      "types": "./dist/webpack.d.ts",
      "default": "./dist/webpack.js"
    },
    "./rspack": {
      "types": "./dist/rspack.d.ts",
      "default": "./dist/rspack.js"
    },
    "./rollup": {
      "types": "./dist/rollup.d.ts",
      "default": "./dist/rollup.js"
    },
    "./rolldown": {
      "types": "./dist/rolldown.d.ts",
      "default": "./dist/rolldown.js"
    },
    "./esbuild": {
      "types": "./dist/esbuild.d.ts",
      "default": "./dist/esbuild.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "node ../../scripts/copy-licenses.js",
    "build:js": "tsc -p tsconfig.json",
    "build": "pnpm run build:js",
    "build:debug": "pnpm run build:js",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@compatgate/core": "workspace:^",
    "@jridgewell/trace-mapping": "^0.3.31",
    "picomatch": "^4.0.7",
    "unplugin": "catalog:"
  },
  "devDependencies": {
    "@rspack/core": "catalog:",
    "@swc/core": "catalog:",
    "@types/node": "catalog:",
    "@types/picomatch": "^4.0.3",
    "@vitejs/plugin-vue": "catalog:",
    "esbuild": "catalog:",
    "rolldown": "catalog:",
    "rollup": "catalog:",
    "swc-loader": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vue": "catalog:",
    "webpack": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
