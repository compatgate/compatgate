{
  "name": "@compatgate/eslint",
  "version": "0.0.0",
  "description": "ESLint and oxlint rules that find JavaScript syntax and APIs that your browserslist targets do not support.",
  "keywords": [
    "browserslist",
    "compatibility",
    "eslint",
    "eslintplugin",
    "oxlint"
  ],
  "homepage": "https://github.com/compatgate/compatgate/tree/main/packages/eslint#readme",
  "bugs": {
    "url": "https://github.com/compatgate/compatgate/issues"
  },
  "license": "MIT OR Apache-2.0",
  "author": "Shamil Iakupov <me@shamil.tech>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/compatgate/compatgate.git",
    "directory": "packages/eslint"
  },
  "files": [
    "dist",
    "!dist/*.tsbuildinfo",
    "docs",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "node ../../scripts/copy-licenses.js",
    "build:js": "tsc -p tsconfig.json",
    "build": "pnpm run build:js",
    "build:debug": "pnpm run build:js",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@compatgate/core": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "catalog:",
    "oxlint": "catalog:",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "peerDependencies": {
    "eslint": "^9 || ^10"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    }
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
