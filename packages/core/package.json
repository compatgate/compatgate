{
  "name": "@compatgate/core",
  "version": "0.1.0",
  "description": "Finds JavaScript syntax and APIs that your browserslist targets do not support.",
  "keywords": [
    "baseline",
    "bcd",
    "browserslist",
    "compatibility",
    "lint"
  ],
  "homepage": "https://github.com/compatgate/compatgate/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/compatgate/compatgate/issues"
  },
  "license": "MIT OR Apache-2.0",
  "author": "Shamil Iakupov <me@shamil.tech>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/compatgate/compatgate.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "!dist/*.tsbuildinfo",
    "docs",
    "binding.js",
    "binding.d.ts",
    "compatgate.schema.json",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "THIRD-PARTY-LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./compatgate.schema.json": "./compatgate.schema.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "node ../../scripts/copy-licenses.js",
    "build:native": "napi build --platform --release --esm --no-const-enum --js binding.js --dts binding.d.ts",
    "build:native:debug": "napi build --platform --esm --no-const-enum --js binding.js --dts binding.d.ts",
    "build:js": "tsc -p tsconfig.json",
    "build": "pnpm run build:native && pnpm run build:js",
    "build:debug": "pnpm run build:native:debug && pnpm run build:js",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "prepublishOnly": "echo Publish through release.yml: it packs the packages as npm serves them. && exit 1"
  },
  "dependencies": {
    "browserslist": "^4.29.3",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@compatgate/test-utils": "workspace:*",
    "@emnapi/core": "2.0.0-alpha.6",
    "@emnapi/runtime": "2.0.0-alpha.6",
    "@napi-rs/cli": "catalog:",
    "@napi-rs/wasm-runtime": "^1.2.5",
    "@types/node": "catalog:",
    "ajv": "8.20.0",
    "emnapi": "2.0.0-alpha.6",
    "typescript": "catalog:"
  },
  "napi": {
    "binaryName": "compatgate",
    "rootPublisher": "pnpm",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc",
      "wasm32-wasip1-threads"
    ],
    "wasm": {
      "optionalDependency": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
