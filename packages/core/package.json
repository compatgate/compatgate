{
  "name": "@compatgate/core",
  "version": "0.0.0",
  "description": "Finds JavaScript syntax and APIs that your browserslist targets do not support.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "binding.cjs", "binding.d.cts", "*.node"],
  "napi": {
    "binaryName": "compatgate"
  },
  "scripts": {
    "build:native": "napi build --platform --release --js binding.cjs --dts binding.d.cts",
    "build:js": "tsc -p tsconfig.json",
    "build": "pnpm run build:native && pnpm run build:js",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "browserslist": "^4.29.3",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.8",
    "@types/node": "^24",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
