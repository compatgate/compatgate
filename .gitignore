target/
node_modules/
packages/*/dist/
packages/core/*.node
# Copies of the root licenses: `prepack` puts them into each package.
packages/*/LICENSE-MIT
packages/*/LICENSE-APACHE
# The fixture of the conformance suite has packages of its own.
!/conformance/fixture/node_modules/
!/conformance/fixture/node_modules/**/node_modules/
# The platform packages and the binaries that CI makes for a release.
npm/
artifacts/
*.wasm
*.tgz
# The loader of the wasm build that `napi build` writes next to the binary.
packages/core/*.wasi.cjs
packages/core/*.wasi-browser.js
packages/core/wasi-worker*.mjs
# Generated by `pnpm third-party` when a release packs the core.
packages/core/THIRD-PARTY-LICENSE
